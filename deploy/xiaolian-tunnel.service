# systemd service for the Cloudflare tunnel that lets other admins open the
# member table. It starts at boot and restarts if it stops.
# Install (see docs/DEPLOY.md, "The member table for other admins"):
#   sudo cp /home/xiaolian/XiaoLianBot/deploy/xiaolian-tunnel.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now xiaolian-tunnel
#
# Two kinds of tunnel:
# - quick tunnel (default): a random *.trycloudflare.com address, new every time it starts;
# - named tunnel: a fixed address on your own domain, used once deploy/tunnel-fixed.sh
#   has saved the tunnel's token in /etc/xiaolian/tunnel.env.
# To print the current link, token included: sudo /home/xiaolian/XiaoLianBot/deploy/tunnel-link.sh

[Unit]
Description=Cloudflare tunnel to the XiaoLian member table
Wants=network-online.target
After=network-online.target xiaolian.service

[Service]
Type=simple
# systemd reads this file as root, so it stays readable by root only. cloudflared
# takes the token from the environment, so it never shows in the process list.
EnvironmentFile=-/etc/xiaolian/tunnel.env
# ($$ is a plain $ once systemd has read the line.)
ExecStart=/bin/sh -c 'if [ -n "$${TUNNEL_TOKEN:-}" ]; then exec /usr/bin/cloudflared tunnel --no-autoupdate run; else exec /usr/bin/cloudflared tunnel --no-autoupdate --url http://127.0.0.1:8765; fi'
Restart=always
RestartSec=10

# It only forwards traffic, so it runs as a throwaway user that can write
# nowhere except its own state folder.
DynamicUser=true
StateDirectory=xiaolian-tunnel
Environment=HOME=/var/lib/xiaolian-tunnel
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
